<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/dark_surface_container"
    android:nextFocusDown="@+id/drawer_header_action_button"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/drawer_header_padding_top"
        android:fitsSystemWindows="true"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- App Logo and Brand -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                app:srcCompat="@mipmap/ic_launcher"
                tools:ignore="ContentDescription" />

            <org.schabi.newpipe.views.NewPipeTextView
                android:id="@+id/drawer_header_newpipe_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/libretube_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Material 3 Service Selector Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/item_state_overlay"
            android:backgroundTint="@color/dark_surface_container_high"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/drawer_header_service_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:scaleType="fitCenter"
                app:tint="@color/libretube_blue"
                tools:ignore="ContentDescription"
                tools:srcCompat="@drawable/place_holder_youtube" />

            <org.schabi.newpipe.views.NewPipeTextView
                android:id="@+id/drawer_header_service_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/libretube_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="YouTube" />

            <ImageView
                android:id="@+id/drawer_arrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                app:srcCompat="@drawable/ic_arrow_drop_down"
                app:tint="@color/libretube_text_secondary"
                tools:ignore="ContentDescription" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/drawer_header_action_button"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
